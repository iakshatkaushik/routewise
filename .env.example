# Copy to .env (never commit .env). Any OpenAI-compatible provider works.
# Leave LLM_API_KEY empty for the routing-only demo (no model is called).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# The two models the router chooses between (model IDs change: check the provider's model list).
CHEAP_MODEL=openai/gpt-oss-20b
STRONG_MODEL=openai/gpt-oss-120b
# Longest answer, in tokens. gpt-oss models reason before they answer, and that reasoning counts too.
MAX_TOKENS=2048
# Reasoning effort, sent to gpt-oss models only.
LLM_REASONING_EFFORT=low
# full = the final router (fine-tuned transformer); light = the Ridge regression router for 512 MB servers.
ROUTER_MODE=full
# Rate limits per IP address.
CHAT_LIMIT_PER_10MIN=15
ROUTE_LIMIT_PER_MIN=120
